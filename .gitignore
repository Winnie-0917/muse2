# Python 虛擬環境
venv/
.venv/
env/

# Python 快取 / 編譯檔
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# 錄製的原始 EEG 資料都放在 Data/：
# 只保留空資料夾（.gitkeep），資料夾內的實際錄製檔不上傳
Data/*
!Data/.gitkeep
eeg_*.csv
*.csv

# 但訓練用的標註資料要上傳（檔案很小，方便重現訓練結果）
!Model/boring/*.csv
!Model/interesting/*.csv
!PDF_Experiment/*.csv
!Learn8_Experiment/*.csv

# 作業系統 / 編輯器
.DS_Store
.idea/
.vscode/
*.swp
